<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Baqyat Qasim</title>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Scheherazade+New:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #c9a84c;
    --gold-light: #e8c97a;
    --gold-dark: #8a6a1f;
    --emerald: #1a5c3a;
    --emerald-light: #2d8a57;
    --emerald-dark: #0d3320;
    --cell-size: clamp(28px, 8vw, 52px);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  body {
    background: var(--emerald-dark);
    background-image:
      radial-gradient(ellipse at 20% 20%, rgba(201,168,76,0.08) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 80%, rgba(45,138,87,0.12) 0%, transparent 50%);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 16px 12px 24px;
    font-family: 'Amiri', serif;
    overflow-x: hidden;
  }

  /* ─── Header ─── */
  .header {
    text-align: center;
    margin-bottom: 18px;
    animation: fadeDown 0.7s ease both;
  }
  .header h1 {
    font-family: 'Scheherazade New', serif;
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    color: var(--gold-light);
    text-shadow: 0 2px 12px rgba(201,168,76,0.4);
    letter-spacing: 2px;
    line-height: 1.2;
  }
  .header .bismillah {
    font-size: clamp(0.85rem, 3vw, 1.1rem);
    color: rgba(232,201,122,0.6);
    margin-top: 4px;
  }

  /* ─── Dhikr Selector ─── */
  .dhikr-selector {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 16px;
    animation: fadeDown 0.8s ease both;
  }

  /* wrapper for btn + badge */
  .dhikr-btn-wrap {
    position: relative;
    display: inline-flex;
  }

  .dhikr-btn {
    background: rgba(201,168,76,0.1);
    border: 1.5px solid rgba(201,168,76,0.35);
    color: var(--gold-light);
    font-family: 'Amiri', serif;
    font-size: clamp(0.75rem, 2.5vw, 0.95rem);
    padding: 6px 14px;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.25s;
    white-space: nowrap;
  }
  .dhikr-btn:hover, .dhikr-btn.active {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--emerald-dark);
    font-weight: 700;
    box-shadow: 0 0 16px rgba(201,168,76,0.5);
  }

  /* ── Badge (notification dot) ── */
  .badge {
    display: none;
    position: absolute;
    top: -6px;
    left: -6px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 50px;
    background: #e05c3a;
    color: #fff;
    font-family: 'Amiri', serif;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
    box-shadow: 0 0 8px rgba(224,92,58,0.7);
    pointer-events: none;
    z-index: 10;
    animation: badgePop 0.3s cubic-bezier(0.34,1.56,0.64,1) both;
  }
  .badge.visible { display: block; }

  /* ─── Counter Display ─── */
  .counter-display {
    text-align: center;
    margin-bottom: 14px;
    animation: fadeDown 0.9s ease both;
  }
  .counter-number {
    font-family: 'Scheherazade New', serif;
    font-size: clamp(2.8rem, 11vw, 5rem);
    color: var(--gold-light);
    text-shadow: 0 0 30px rgba(201,168,76,0.5);
    line-height: 1;
    transition: transform 0.1s ease;
  }
  .counter-number.bump { transform: scale(1.12); }
  .counter-label {
    font-size: clamp(0.8rem, 2.8vw, 1rem);
    color: rgba(232,201,122,0.55);
    margin-top: 2px;
  }

  /* ─── Grid Wrapper ─── */
  .grid-wrapper { position: relative; animation: fadeUp 0.9s ease both; }
  .grid-frame {
    background: linear-gradient(145deg, rgba(201,168,76,0.18), rgba(201,168,76,0.06));
    border: 2px solid rgba(201,168,76,0.4);
    border-radius: 16px;
    padding: 10px;
    box-shadow: 0 0 0 1px rgba(201,168,76,0.15), 0 8px 32px rgba(0,0,0,0.5), inset 0 1px 0 rgba(201,168,76,0.2);
    position: relative;
  }
  .grid-frame::before, .grid-frame::after {
    content: '✦'; position: absolute; color: rgba(201,168,76,0.4); font-size: 14px; top: 4px;
  }
  .grid-frame::before { right: 8px; }
  .grid-frame::after  { left: 8px; }

  /* ─── Grid ─── */
  .grid {
    display: grid;
    grid-template-columns: repeat(10, var(--cell-size));
    grid-template-rows:    repeat(10, var(--cell-size));
    gap: 4px;
    cursor: pointer;
    user-select: none;
    touch-action: manipulation;
  }
  .cell {
    border-radius: 6px;
    background: rgba(13,51,32,0.7);
    border: 1px solid rgba(201,168,76,0.18);
    transition: background 0.3s ease, transform 0.15s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .cell::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at center, rgba(255,255,255,0.18), transparent 70%);
    opacity: 0; transition: opacity 0.3s;
  }
  .cell.filled {
    background: var(--gold);
    border-color: var(--gold-dark);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 0 8px rgba(201,168,76,0.4);
  }
  .cell.filled::after { opacity: 1; }
  .cell.just-filled { animation: cellPop 0.35s cubic-bezier(0.34,1.56,0.64,1) both; }
  .cell.last-row { background: rgba(45,138,87,0.25); border-color: rgba(45,138,87,0.4); }
  .cell.last-row.filled {
    background: var(--emerald-light);
    border-color: var(--emerald);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.2), 0 0 10px rgba(45,138,87,0.5);
  }

  /* ─── Progress Bar ─── */
  .progress-row { display: flex; align-items: center; gap: 10px; margin-top: 12px; padding: 0 4px; }
  .progress-bar-bg {
    flex: 1; height: 6px;
    background: rgba(201,168,76,0.12);
    border-radius: 99px; overflow: hidden;
    border: 1px solid rgba(201,168,76,0.2);
  }
  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--gold-dark), var(--gold-light));
    border-radius: 99px; transition: width 0.4s ease;
    box-shadow: 0 0 8px rgba(201,168,76,0.5);
  }
  .progress-text { font-size: 0.8rem; color: rgba(232,201,122,0.6); min-width: 32px; text-align: left; }

  /* ─── Action Buttons ─── */
  .actions { display: flex; gap: 12px; margin-top: 16px; animation: fadeUp 1s ease both; }
  .action-btn {
    flex: 1; padding: 12px 0; border-radius: 12px; border: none;
    font-family: 'Amiri', serif; font-size: clamp(0.9rem, 3vw, 1.1rem);
    cursor: pointer; transition: all 0.2s; font-weight: 700;
  }
  .btn-reset {
    background: rgba(201,168,76,0.1);
    border: 1.5px solid rgba(201,168,76,0.3);
    color: var(--gold-light);
  }
  .btn-reset:hover { background: rgba(201,168,76,0.2); }

  .btn-reset-all {
    background: rgba(224,92,58,0.1);
    border: 1.5px solid rgba(224,92,58,0.35);
    color: #f0956e;
  }
  .btn-reset-all:hover { background: rgba(224,92,58,0.2); }

  .btn-minus {
    background: rgba(201,168,76,0.1);
    border: 1.5px solid rgba(201,168,76,0.3);
    color: var(--gold-light);
    max-width: 56px; min-width: 56px;
    font-size: 1.4rem; line-height: 1; padding: 10px 0;
  }
  .btn-minus:hover { background: rgba(201,168,76,0.2); }

  /* ─── Complete Overlay ─── */
  .complete-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(13,51,32,0.92); backdrop-filter: blur(6px);
    z-index: 100; flex-direction: column; align-items: center;
    justify-content: center; text-align: center; padding: 32px;
  }
  .complete-overlay.show { display: flex; animation: fadeIn 0.4s ease; }
  .complete-overlay .star { font-size: 3rem; animation: spin 3s linear infinite; }
  .complete-overlay h2 {
    font-family: 'Scheherazade New', serif;
    font-size: clamp(1.8rem, 6vw, 2.8rem);
    color: var(--gold-light);
    text-shadow: 0 0 30px rgba(201,168,76,0.7);
    margin: 16px 0 8px;
  }
  .complete-overlay p { color: rgba(232,201,122,0.7); font-size: clamp(1rem, 3.5vw, 1.3rem); margin-bottom: 28px; line-height: 1.6; }
  .complete-session {
    background: rgba(201,168,76,0.12); border: 1px solid rgba(201,168,76,0.3);
    border-radius: 12px; padding: 12px 24px; color: var(--gold-light); font-size: 1rem; margin-bottom: 24px;
  }
  .btn-continue {
    background: var(--gold); color: var(--emerald-dark); border: none;
    padding: 14px 40px; border-radius: 50px; font-family: 'Amiri', serif;
    font-size: 1.1rem; font-weight: 700; cursor: pointer;
    box-shadow: 0 0 24px rgba(201,168,76,0.5); transition: transform 0.2s;
  }
  .btn-continue:hover { transform: scale(1.05); }

  /* ─── Particles ─── */
  .particles { position: fixed; inset: 0; pointer-events: none; z-index: 50; }
  .particle {
    position: absolute; width: 6px; height: 6px; border-radius: 50%;
    background: var(--gold); pointer-events: none;
    animation: particleFly 0.8s ease-out forwards;
  }

  /* ─── Session Stats ─── */
  .session-stats { display: flex; gap: 16px; margin-top: 14px; animation: fadeUp 1.1s ease both; }
  .stat-box {
    flex: 1; background: rgba(201,168,76,0.07); border: 1px solid rgba(201,168,76,0.2);
    border-radius: 10px; padding: 8px 10px; text-align: center;
  }
  .stat-value { font-family: 'Scheherazade New', serif; font-size: clamp(1.1rem, 4vw, 1.5rem); color: var(--gold-light); }
  .stat-label { font-size: clamp(0.65rem, 2vw, 0.78rem); color: rgba(232,201,122,0.5); margin-top: 2px; }

  /* ─── Animations ─── */
  @keyframes fadeDown { from { opacity:0; transform:translateY(-16px); } to { opacity:1; transform:translateY(0); } }
  @keyframes fadeUp   { from { opacity:0; transform:translateY(16px);  } to { opacity:1; transform:translateY(0); } }
  @keyframes fadeIn   { from { opacity:0; } to { opacity:1; } }
  @keyframes cellPop  { 0%{transform:scale(0.7);} 60%{transform:scale(1.18);} 100%{transform:scale(1);} }
  @keyframes particleFly { 0%{opacity:1;transform:translate(0,0) scale(1);} 100%{opacity:0;transform:translate(var(--dx),var(--dy)) scale(0.3);} }
  @keyframes spin     { from{transform:rotate(0deg);} to{transform:rotate(360deg);} }
  @keyframes badgePop { 0%{transform:scale(0);} 70%{transform:scale(1.3);} 100%{transform:scale(1);} }
</style>
</head>
<body>

<div class="particles" id="particles"></div>

<!-- Complete Overlay -->
<div class="complete-overlay" id="completeOverlay">
  <div class="star">☪</div>
  <h2>مبارك! اكتملت المئة</h2>
  <p id="completeDhikrName">سبحان الله</p>
  <div class="complete-session" id="sessionInfo">عدد الجلسات: ١</div>
  <button class="btn-continue" onclick="continueSession()">متابعة الذكر</button>
</div>

<!-- Header -->
<div class="header">
  <div class="bismillah">بسم الله الرحمن الرحيم</div>
  <h1>عداد الذكر</h1>
</div>

<!-- Dhikr Selector -->
<div class="dhikr-selector" id="dhikrSelector">
  <div class="dhikr-btn-wrap">
    <button class="dhikr-btn active" data-dhikr="سبحان الله" onclick="setDhikr(this)">سبحان الله</button>
    <span class="badge" id="badge-سبحان الله">0</span>
  </div>
  <div class="dhikr-btn-wrap">
    <button class="dhikr-btn" data-dhikr="الحمد لله" onclick="setDhikr(this)">الحمد لله</button>
    <span class="badge" id="badge-الحمد لله">0</span>
  </div>
  <div class="dhikr-btn-wrap">
    <button class="dhikr-btn" data-dhikr="الله أكبر" onclick="setDhikr(this)">الله أكبر</button>
    <span class="badge" id="badge-الله أكبر">0</span>
  </div>
  <div class="dhikr-btn-wrap">
    <button class="dhikr-btn" data-dhikr="لا إله إلا الله" onclick="setDhikr(this)">لا إله إلا الله</button>
    <span class="badge" id="badge-لا إله إلا الله">0</span>
  </div>
  <div class="dhikr-btn-wrap">
    <button class="dhikr-btn" data-dhikr="استغفر الله" onclick="setDhikr(this)">استغفر الله</button>
    <span class="badge" id="badge-استغفر الله">0</span>
  </div>
</div>

<!-- Counter Display -->
<div class="counter-display">
  <div class="counter-number" id="counterNum">0</div>
  <div class="counter-label">اضغط في أي مكان على الشبكة</div>
</div>

<!-- Grid -->
<div class="grid-wrapper">
  <div class="grid-frame">
    <div class="grid" id="grid" onclick="handleGridClick()"></div>
    <div class="progress-row">
      <div class="progress-bar-bg">
        <div class="progress-bar-fill" id="progressFill" style="width:0%"></div>
      </div>
      <div class="progress-text" id="progressText">0٪</div>
    </div>
  </div>
</div>

<!-- Action Buttons -->
<div class="actions">
  <button class="action-btn btn-minus" onclick="decrementCount()" title="تراجع">−</button>
  <button class="action-btn btn-reset" onclick="resetGrid()">تصفير الشبكة</button>
  <button class="action-btn btn-reset-all" onclick="resetAll()">تصفير الكل</button>
</div>

<!-- Session Stats -->
<div class="session-stats">
  <div class="stat-box">
    <div class="stat-value" id="statSessions">٠</div>
    <div class="stat-label">جلسات مكتملة</div>
  </div>
  <div class="stat-box">
    <div class="stat-value" id="statTotal">٠</div>
    <div class="stat-label">إجمالي الذكر</div>
  </div>
  <div class="stat-box">
    <div class="stat-value" id="statCurrent">سبحان الله</div>
    <div class="stat-label">الذكر الحالي</div>
  </div>
</div>

<script>
  const TOTAL = 100;

  // Per-dhikr state: { count, sessions, total }
  const dhikrList = ['سبحان الله','الحمد لله','الله أكبر','لا إله إلا الله','استغفر الله'];
  const state = {};
  dhikrList.forEach(d => { state[d] = { count: 0, sessions: 0, total: 0 }; });

  let currentDhikr = 'سبحان الله';

  // Build grid
  const gridEl = document.getElementById('grid');
  for (let i = 0; i < TOTAL; i++) {
    const cell = document.createElement('div');
    cell.className = 'cell' + (i >= 90 ? ' last-row' : '');
    gridEl.appendChild(cell);
  }
  const cells = gridEl.querySelectorAll('.cell');

  function toAr(n) {
    return String(n).replace(/\d/g, d => '٠١٢٣٤٥٦٧٨٩'[d]);
  }

  function cur() { return state[currentDhikr]; }

  function updateDisplay() {
    const s = cur();

    // big counter
    const num = document.getElementById('counterNum');
    num.textContent = toAr(s.count);
    num.classList.remove('bump');
    void num.offsetWidth;
    num.classList.add('bump');
    setTimeout(() => num.classList.remove('bump'), 200);

    // progress bar
    const pct = Math.round(s.count / TOTAL * 100);
    document.getElementById('progressFill').style.width = pct + '%';
    document.getElementById('progressText').textContent = toAr(pct) + '٪';

    // stats row
    document.getElementById('statSessions').textContent = toAr(s.sessions);
    document.getElementById('statTotal').textContent    = toAr(s.total);
    document.getElementById('statCurrent').textContent  = currentDhikr;

    // grid cells
    cells.forEach((c, i) => {
      if (i < s.count) c.classList.add('filled');
      else             c.classList.remove('filled', 'just-filled');
    });

    // badges for all dhikrs
    dhikrList.forEach(d => {
      const badge = document.getElementById('badge-' + d);
      const n = state[d].sessions;
      if (n > 0) {
        badge.textContent = toAr(n);
        badge.classList.add('visible');
      } else {
        badge.classList.remove('visible');
      }
    });
  }

  function handleGridClick() {
    const s = cur();
    if (s.count >= TOTAL) return;
    const cell = cells[s.count];
    cell.classList.add('filled', 'just-filled');
    spawnParticles(cell);
    s.count++;
    s.total++;
    updateDisplay();
    if (s.count === TOTAL) {
      s.sessions++;
      updateDisplay();
      setTimeout(showComplete, 400);
    }
  }

  function decrementCount() {
    const s = cur();
    if (s.count <= 0) return;
    s.count--;
    s.total = Math.max(0, s.total - 1);
    cells[s.count].classList.remove('filled', 'just-filled');
    updateDisplay();
  }

  function resetGrid() {
    cur().count = 0;
    cells.forEach(c => c.classList.remove('filled', 'just-filled'));
    updateDisplay();
  }

  function resetAll() {
    // Reset everything for ALL dhikrs
    dhikrList.forEach(d => { state[d] = { count: 0, sessions: 0, total: 0 }; });
    cells.forEach(c => c.classList.remove('filled', 'just-filled'));
    updateDisplay();
  }

  function showComplete() {
    const s = cur();
    document.getElementById('completeDhikrName').textContent = currentDhikr + ' × ١٠٠';
    document.getElementById('sessionInfo').textContent =
      'الجلسة رقم: ' + toAr(s.sessions) + '  •  الإجمالي: ' + toAr(s.total);
    document.getElementById('completeOverlay').classList.add('show');
  }

  function continueSession() {
    document.getElementById('completeOverlay').classList.remove('show');
    cur().count = 0;
    cells.forEach(c => c.classList.remove('filled', 'just-filled'));
    updateDisplay();
  }

  function setDhikr(btn) {
    document.querySelectorAll('.dhikr-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentDhikr = btn.dataset.dhikr;
    // restore grid for this dhikr (re-render)
    updateDisplay();
  }

  function spawnParticles(sourceEl) {
    const rect = sourceEl.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top  + rect.height / 2;
    const container = document.getElementById('particles');
    for (let i = 0; i < 7; i++) {
      const p = document.createElement('div');
      p.className = 'particle';
      const angle = Math.random() * Math.PI * 2;
      const dist  = 30 + Math.random() * 60;
      p.style.left = cx + 'px';
      p.style.top  = cy + 'px';
      p.style.setProperty('--dx', Math.cos(angle) * dist + 'px');
      p.style.setProperty('--dy', Math.sin(angle) * dist + 'px');
      p.style.background = Math.random() > 0.5 ? '#c9a84c' : '#e8c97a';
      p.style.width  = (4 + Math.random() * 5) + 'px';
      p.style.height = p.style.width;
      container.appendChild(p);
      setTimeout(() => p.remove(), 900);
    }
  }

  updateDisplay();
</script>
</body>
</html>
